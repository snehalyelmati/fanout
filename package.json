{
  "name": "fanout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "keywords": ["fanout", "doubleword", "pi-package"],
  "scripts": {
    "build": "echo 'nothing to build'",
    "check": "node scripts/check-models.mjs && node scripts/test-doubleword-model-cache.mjs",
    "test:doubleword-provider": "node scripts/test-doubleword-model-cache.mjs && node scripts/smoke-live-realtime-mock.mjs && node scripts/smoke-live-async-mock.mjs",
    "smoke:realtime": "pi -e . --model doubleword-realtime-stub/deepseek-v4-flash -p \"Respond 'hello', do not say anything else.\"",
    "smoke:async": "pi -e . --model doubleword-async-stub/doubleword-async-stub -p \"Respond 'hello', do not say anything else.\"",
    "smoke:live:realtime": "node scripts/smoke-live-realtime.mjs",
    "smoke:live:realtime:mock": "node scripts/smoke-live-realtime-mock.mjs",
    "smoke:live:async": "node scripts/smoke-live-async.mjs",
    "smoke:live:async:mock": "node scripts/smoke-live-async-mock.mjs",
    "smoke:live:batch": "node scripts/smoke-live-batch.mjs",
    "smoke:live:batch:mock": "node scripts/smoke-live-batch-mock.mjs",
    "smoke:observability": "node scripts/smoke-observability.mjs",
    "smoke:planning": "node scripts/smoke-planning.mjs",
    "benchmark:traces": "node scripts/benchmark-traces.mjs",
    "eval:safe-work-units": "node scripts/eval-safe-work-units.mjs",
    "smoke:benchmarks": "node scripts/smoke-benchmarks.mjs"
  },
  "pi": {
    "extensions": ["./packages/fanout-pi/src/index.ts"],
    "prompts": ["./packages/fanout-pi/prompts/dw-plan.md"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
